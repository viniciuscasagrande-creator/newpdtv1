# Fase 21.1.12 — Frontend e API no mesmo projeto Vercel
# O browser deve usar a API same-origin.
VITE_API_URL=/api

# Variáveis privadas da Serverless API — NÃO usar prefixo VITE_ nestas.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=troque-por-uma-chave-longa-aleatoria
TRACKING_TOKEN_SECRET=troque-por-outra-chave-longa-aleatoria
FRONTEND_URL=https://newpdtv1.vercel.app
PUBLIC_APP_URL=https://newpdtv1.vercel.app
NODE_ENV=production
